#! /bin/sh

# Configure monitors and desktops (9 desktops)
bspc monitor -d 1 2 3 4 5 6 7 8 9

# Start sxhkd if not already running
pgrep -x sxhkd > /dev/null || sxhkd &

# Start lemonbar panel (after bspwm is configured)
pkill -x panel.sh
pkill -x lemonbar
sleep 0.5  # Give bspwm time to set up its socket
$HOME/.config/bspwm/panel.sh | lemonbar -g x22 -B "#1a1a1a" -F "#CCCCCC" -f "DejaVu Sans Mono:size=10" &

# Window appearance
bspc config border_width         1
bspc config window_gap          12

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Focus follows mouse
bspc config focus_follows_pointer true

# Application rules
bspc rule -a Gimp state=floating follow=on
bspc rule -a mplayer2 state=floating
bspc rule -a Screenkey manage=off
