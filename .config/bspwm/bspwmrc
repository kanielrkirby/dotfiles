#!/usr/bin/env bash

# Configure monitors and desktops
bspc monitor -d 1 2 3 4 5 6 7 8 9

# Start sxhkd if not already running
pgrep -x sxhkd > /dev/null || sxhkd &

# Start lemonbar panel (after bspwm is configured)
pkill -f "/home/mx/.config/bspwm/panel.py" 2>/dev/null || true
pkill -x lemonbar 2>/dev/null || true
/home/mx/.config/bspwm/panel.py 2>/dev/null | lemonbar -n "panel" -a 32 -g x22 -B "#1a1a1a" -F "#CCCCCC" -f "DejaVu Sans Mono:size=10" | bash &

# Hide/show bar on fullscreen
{
    bspc subscribe node_state desktop_focus node_focus | while read -r event rest; do
        # Check if any window on the current desktop is fullscreen
        if bspc query -N -n .focused.fullscreen -d focused &>/dev/null; then
            xdotool search --classname lemonbar windowunmap
        else
            xdotool search --classname lemonbar windowmap
        fi
    done
} &

# Window appearance
bspc config border_width         1
bspc config window_gap          12

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Disable focus follows mouse. This causes full-screen blocking XFCE or other Desktop Manager
bspc config focus_follows_pointer false

# Application rules
bspc rule -a Gimp state=floating follow=on
bspc rule -a mplayer2 state=floating
bspc rule -a Screenkey manage=off

# Start flameshot
pkill -x flameshot 2>/dev/null || true
flameshot &

# Notifications
dunst &

# Background
pkill -x feh 2>/dev/null || true
find ~/Documents/wallpapers -type f -print0 | shuf -z -n 1 | xargs -0 -r feh --bg-fill
