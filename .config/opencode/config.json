{
  "$schema": "https://opencode.ai/config.json",
  // ============================================================================
  // BASE PERMISSIONS (from documentation - commented out for reference)
  // ============================================================================
  // "permission": {
  //   "read": "allow",           - reading files
  //   "edit": "allow",           - all file modifications (edit, write, patch, multiedit)
  //   "glob": "allow",           - file globbing
  //   "grep": "allow",           - content search
  //   "list": "allow",           - listing files in a directory
  //   "bash": "allow",           - running shell commands
  //   "task": "allow",           - launching subagents
  //   "skill": "allow",          - loading a skill
  //   "lsp": "allow",            - running LSP queries
  //   "todoread": "allow",       - reading the todo list
  //   "todowrite": "allow",      - updating the todo list
  //   "webfetch": "allow",       - fetching a URL
  //   "websearch": "allow",      - web search
  //   "codesearch": "allow",     - code search
  //   "external_directory": "ask", - accessing paths outside project
  //   "doom_loop": "ask"         - repeated identical tool calls
  // },
  // ============================================================================
  // MCP Servers
  "mcp": {
    "trello": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@delorenj/mcp-server-trello"
      ],
      "environment": {
        "TRELLO_API_KEY": "YOUR_API_KEY_HERE",
        "TRELLO_TOKEN": "YOUR_TOKEN_HERE"
      }
    },
    "freshbooks": {
      "enabled": false,
      "type": "local",
      "command": [
        "node",
        "/home/mx/.opencode/freshbooks-mcp-server/dist/index.js"
      ],
      "environment": {
        "FRESHBOOKS_CLIENT_ID": "YOUR_CLIENT_ID_HERE",
        "FRESHBOOKS_CLIENT_SECRET": "YOUR_CLIENT_SECRET_HERE"
      }
    },
    "browser": {
      "enabled": false,
      "type": "local",
      "command": [
        "node",
        "/home/mx/.opencode/agent-browser-mcp-patched/dist/index.js"
      ],
      "environment": {
        "AUTO_CONNECT": "true",
        "CDP_PORT": "9222"
      }
    }
  },
  // Top-level permissions: disallow mutational git and gh commands
  "permission": {
    "*": "allow",
    // Deny reading database config files (contain passwords)
    "read": {
      "*": "allow",
      "**/.opencode/plugins/database/config.json": "deny",
      "**/plugins/database/config.json": "deny"
    },
    // Git commands - only allow non-mutational operations
    "bash": {
      "*": "allow",
      "git*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git reflog*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git push --force": "deny",
      "git push -f": "deny",
      "gh *": "ask",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh pr diff*": "allow",
      "gh pr status*": "allow"
    }
  },
  // Agent configurations
  "agent": {}
}