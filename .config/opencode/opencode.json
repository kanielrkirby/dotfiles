{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "mcp": {
    "kb": {
      "type": "local",
      "command": [
        "/home/mx/.config/opencode/kb-wrapper.sh"
      ],
      "enabled": true
    },
    "db": {
      "type": "local",
      "command": [
        "/home/mx/.config/opencode/db-wrapper.sh"
      ],
      "enabled": true
    },
    "odoo": {
      "type": "local",
      "command": [
        "/home/mx/.config/opencode/odoo-wrapper.sh"
      ],
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "--add-host=host.docker.internal:host-gateway",
        "-e",
        "FIRECRAWL_API_URL=http://host.docker.internal:3915",
        "firecrawl-mcp-server"
      ],
      "enabled": false,
      "timeout": 600000
    }
  },
  "mode": {
