{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-with-claude"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:9152",
        "apiKey": "dummy"
      }
    }
  },
  "default_agent": "simple",
  "permission": {
    "read": {
      "~/.aws/**": "deny",
      "/home/mx/.aws/**": "deny",
      "~/.ssh/**": "deny",
      "/home/mx/.ssh/**": "deny"
    },
    "edit": {
      "~/.config/opencode/**": "ask",
      "/home/mx/.config/opencode/**": "ask"
    }
  },
  "mcp": {
    "graphiti": {
      "type": "remote",
      "url": "http://localhost:14045/mcp/",
      "enabled": false,
      "timeout": 60000
    },
    "mem0": {
      "type": "remote",
      "url": "http://localhost:15708/mcp/opencode/sse/mx",
      "enabled": false,
      "timeout": 60000
    },
    "odoo": {
      "type": "local",
      "command": [
        "/home/mx/.config/opencode/odoo-wrapper.sh"
      ],
      "enabled": true
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
      "timeout": 60000
    }
  }
}