{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-with-claude"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:9152",
        "apiKey": "dummy"
      }
    }
  },
  "mcp": {
    "graphiti": {
      "type": "remote",
      "url": "http://localhost:14045/mcp/",
      "enabled": true,
      "timeout": 60000
    },
    "mem0": {
      "type": "remote",
      "url": "http://localhost:15708/mcp/opencode/sse/mx",
      "enabled": true,
      "timeout": 60000
    },
    "odoo": {
      "type": "local",
      "command": [
        "/home/mx/.config/opencode/odoo-wrapper.sh"
      ],
      "enabled": true
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
      "timeout": 60000
    }
  }
}
