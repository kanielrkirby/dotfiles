#
# wm independent hotkeys
#

# terminal emulator
super + shift + Return
	wezterm

# program launcher
super + p
	gumenu

# whispaste (voice to text)
super + backslash
	whispaste

# paste clipboard Markdown as HTML
super + ctrl + v
	markdown-paste


# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

# Workspace switching
super + semicolon ; 1
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh switch 1

super + semicolon ; 2
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh switch 2

super + semicolon ; 3
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh switch 3

# Move window to specific desktop in specific workspace
# super + shift + ; + <workspace> + <desktop>
super + shift + semicolon ; 1 ; {1-9,0}
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh move-to-workspace 1 {1-9,10}

super + shift + semicolon ; 2 ; {1-9,0}
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh move-to-workspace 2 {1-9,10}

super + shift + semicolon ; 3 ; {1-9,0}
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh move-to-workspace 3 {1-9,10}

# screenshots
super + alt + 3
	flameshot gui --clipboard

super + alt + 4
	flameshot gui --path ~/Pictures

super + alt + 5
	shot

# brightness control
XF86MonBrightnessUp
	brightnessctl set 5%+

XF86MonBrightnessDown
	brightnessctl set 5%-

super + XF86MonBrightnessUp
	brightnessctl set 15%+

super + XF86MonBrightnessDown
	brightnessctl set 15%-

# volume control
XF86AudioRaiseVolume
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+

XF86AudioLowerVolume
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-

XF86AudioMute
	wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

XF86AudioMicMute
	pactl set-source-mute @DEFAULT_SOURCE@ toggle

#
# bspwm hotkeys
#

# quit/restart bspwm
super + shift + q
	bspc quit

super + shift + r
	bspc wm -r

# close and kill
super + {_,shift + }c
	bspc node -{c,k}

# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

# swap the current node and the biggest window
super + g
	bspc node -s biggest.window

#
# state/flags
#

# set the window state
super + {t,shift + t,apostrophe,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

#
# focus/swap
#

# focus the node in the given direction
super + {_,shift + }{h,j,k,l}
	bspc node -{f,s} {west,south,north,east}

# focus the next/previous desktop in the current monitor
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# focus the last node/desktop
super + Tab
	bspc desktop -f last

# focus or send to the given desktop (within current workspace)
super + {_,shift + }{1-9,0}
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh {focus,move} {1-9,10}

#
# preselect
#

# preselect the direction
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

# preselect the ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# cancel the preselection for the focused node
super + ctrl + space
	bspc node -p cancel

# cancel the preselection for the focused desktop
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#
# move/resize
#

# expand a window by moving one of its side outward
super + alt + h
	bspc node -z left -20 0
super + alt + j
	bspc node -z top 0 20
super + alt + k
	bspc node -z top 0 -20
super + alt + l
	bspc node -z left 20 0

# move a floating window
super + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

# multi-monitor support
super + ctrl + {comma,period}
	bspc monitor -f {prev,next}

super + ctrl + shift + {comma,period}
	bspc node -m {prev,next} --follow
