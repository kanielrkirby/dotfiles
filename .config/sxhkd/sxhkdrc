#
# wm independent hotkeys
#

# terminal emulator
super + shift + Return
	st

# program launcher
super + p
	menu_custom

# whispaste (voice to text)
super + backslash
	whispaste

# bitwarden menu
super + comma
	rbwm

# ente auth menu
super + period
	entemenu

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

#
# Modal bindings for system control
#

# Mullvad VPN controls
super + semicolon ; m ; s
	notify-send -r 9001 "Mullvad" "$(mullvad status)"

super + semicolon ; m ; r
	sh -c 'notify-send -r 9001 "Mullvad" "Reconnecting..."; mullvad reconnect --wait && notify-send -r 9001 "Mullvad" "Reconnected"'

super + semicolon ; m ; d
	sh -c 'notify-send -r 9001 "Mullvad" "Disconnecting..."; mullvad disconnect --wait && notify-send -r 9001 "Mullvad" "Disconnected"'

super + semicolon ; m ; c
	sh -c 'notify-send -r 9001 "Mullvad" "Connecting..."; mullvad connect --wait && notify-send -r 9001 "Mullvad" "Connected"'

# WiFi controls
super + semicolon ; w ; c
	sh -c "notify-send -r 9002 'WiFi' 'Connecting...'; nmcli radio wifi on; nmcli --wait 30 connection up 'K&Z' && notify-send -r 9002 'WiFi' 'Connected to K&Z' || notify-send -r 9002 'WiFi' 'Failed to connect'"

super + semicolon ; w ; d
	sh -c 'notify-send -r 9002 "WiFi" "Turning off..."; nmcli radio wifi off && notify-send -r 9002 "WiFi" "Turned off"'

# Bluetooth controls - connect headphones
super + semicolon ; b ; c ; h
	sh -c 'notify-send -r 9003 "Bluetooth" "Connecting to headphones..."; bluetoothctl connect 80:C3:BA:53:50:59 >/dev/null 2>&1 && notify-send -r 9003 "Bluetooth" "Connected to headphones" || notify-send -r 9003 "Bluetooth" "Failed to connect headphones"'

# Bluetooth controls - connect mouse
super + semicolon ; b ; c ; m
	sh -c 'notify-send -r 9003 "Bluetooth" "Connecting to mouse..."; bluetoothctl connect D8:C8:63:41:63:DB >/dev/null 2>&1 && notify-send -r 9003 "Bluetooth" "Connected to mouse" || notify-send -r 9003 "Bluetooth" "Failed to connect mouse"'

# Bluetooth controls - disconnect headphones
super + semicolon ; b ; d ; h
	sh -c 'notify-send -r 9003 "Bluetooth" "Disconnecting headphones..."; bluetoothctl disconnect 80:C3:BA:53:50:59 >/dev/null 2>&1 && notify-send -r 9003 "Bluetooth" "Disconnected headphones" || notify-send -r 9003 "Bluetooth" "Failed to disconnect headphones"'

# Bluetooth controls - disconnect mouse
super + semicolon ; b ; d ; m
	sh -c 'notify-send -r 9003 "Bluetooth" "Disconnecting mouse..."; bluetoothctl disconnect D8:C8:63:41:63:DB >/dev/null 2>&1 && notify-send -r 9003 "Bluetooth" "Disconnected mouse" || notify-send -r 9003 "Bluetooth" "Failed to disconnect mouse"'

# Cycle keyboard layout (US/Spanish)
super + semicolon ; x
	sh -c 'current=$(setxkbmap -query | grep layout | cut -d: -f2 | tr -d " "); case "$current" in us,*|us) setxkbmap -layout es,us && notify-send -r 9004 "Keyboard" "Spanish layout" ;; *) setxkbmap -layout us,es && notify-send -r 9004 "Keyboard" "US layout" ;; esac'

# Workspace switching
super + semicolon ; 1
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh switch 1

super + semicolon ; 2
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh switch 2

super + semicolon ; 3
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh switch 3

# Move window to specific desktop in specific workspace
# super + shift + ; + <workspace> + <desktop>
super + shift + semicolon ; 1 ; {1-9,0}
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh move-to-workspace 1 {1-9,10}

super + shift + semicolon ; 2 ; {1-9,0}
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh move-to-workspace 2 {1-9,10}

super + shift + semicolon ; 3 ; {1-9,0}
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh move-to-workspace 3 {1-9,10}

# screenshots
super + alt + 3
	flameshot gui --clipboard

super + alt + 4
	flameshot gui --path ~/Pictures --accept-on-select --delay 200

# brightness control
XF86MonBrightnessUp
	brightnessctl set 5%+

XF86MonBrightnessDown
	brightnessctl set 5%-

super + XF86MonBrightnessUp
	brightnessctl set 15%+

super + XF86MonBrightnessDown
	brightnessctl set 15%-

# volume control
XF86AudioRaiseVolume
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+

XF86AudioLowerVolume
	wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-

XF86AudioMute
	wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle

XF86AudioMicMute
	pactl set-source-mute @DEFAULT_SOURCE@ toggle

#
# bspwm hotkeys
#

# quit/restart bspwm
super + shift + q
	bspc quit

super + shift + r
	bspc wm -r

# close and kill
super + {_,shift + }c
	bspc node -{c,k}

# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

# swap the current node and the biggest window
super + g
	bspc node -s biggest.window

#
# state/flags
#

# set the window state
super + {t,shift + t,apostrophe,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

#
# focus/swap
#

# focus the node in the given direction
super + {_,shift + }{h,j,k,l}
	bspc node -{f,s} {west,south,north,east}

# focus the next/previous desktop in the current monitor
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# focus the last node/desktop
super + Tab
	bspc desktop -f last

# focus or send to the given desktop (within current workspace)
super + {_,shift + }{1-9,0}
	/home/mx/.config/bspwm/bspwm-workspace-helper.sh {focus,move} {1-9,10}

#
# preselect
#

# preselect the direction
super + ctrl + {h,j,k,l}
	bspc node -p {west,south,north,east}

# preselect the ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# cancel the preselection for the focused node
super + ctrl + space
	bspc node -p cancel

# cancel the preselection for the focused desktop
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#
# move/resize
#

# expand a window by moving one of its side outward
super + alt + {h,j,k,l}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# contract a window by moving one of its side inward
super + alt + shift + {h,j,k,l}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# move a floating window
super + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

# multi-monitor support
super + ctrl + {comma,period}
	bspc monitor -f {prev,next}

super + ctrl + shift + {comma,period}
	bspc node -m {prev,next} --follow
