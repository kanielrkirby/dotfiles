{
  "permission": {
    "*": "allow",
    "email_send": "ask",
    "email_reply": "ask",
    "email_forward": "ask",
    "bash": {
      "dd *": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "poweroff*": "ask",
      "chown *": "ask",
      "chmod *": "ask",
      "rm -rf*": "ask",
      "rm --no-preserve-root*": "ask",
      "mkfs*": "ask",
      "truncate*": "ask",
      "shred*": "ask",
      "find * -delete*": "ask",
      "git *": "ask",
      "gh *": "ask",
      "gh repo delete*": "deny",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "git push --force-with-lease*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git branch --list*": "allow",
      "git remote -v*": "allow",
      "git tag --list*": "allow",
      "gh auth status*": "allow",
      "gh repo view*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh workflow list*": "allow",
      "gh workflow view*": "allow",
      "gh release list*": "allow",
      "gh release view*": "allow"
    }
  }
}