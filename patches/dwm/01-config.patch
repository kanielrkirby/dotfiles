+/* brightness control function */
+void
+brightness(const Arg *arg) {
+	char step[8];
+	int direction = arg->i >> 8;
+	int value = arg->i & 0xFF;
+	
+	snprintf(step, sizeof(step), "%d%%%c", value, direction ? '+' : '-');
+	
+	const char *brightcmd[] = { "brightnessctl", "set", step, NULL };
+	Arg a = {.v = brightcmd};
+	spawn(&a);
+}
+
+/* volume control function */
+void
+volume(const Arg *arg) {
+	char step[8];
+	int action = arg->i >> 8;
+	int value = arg->i & 0xFF;
+	
+	if (action == 2) {
+		const char *mutecmd[] = { "wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle", NULL };
+		Arg a = {.v = mutecmd};
+		spawn(&a);
+	} else {
+		snprintf(step, sizeof(step), "0.%02d%c", value, action ? '+' : '-');
+		const char *volcmd[] = { "wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", step, NULL };
+		Arg a = {.v = volcmd};
+		spawn(&a);
+	}
+}
